{
  "name": "@prahalad-nagu/fast-translation-plugin",
  "version": "0.1.0",
  "description": "Fast POC translation plugin for UI microcopy using OpenAI",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "translation",
    "i18n",
    "openai",
    "typescript"
  ],
  "author": "prahalad-nagu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/prahalad-nagu/fast-translation-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/prahalad-nagu/fast-translation-plugin/issues"
  },
  "homepage": "https://github.com/prahalad-nagu/fast-translation-plugin#readme",
  "dependencies": {
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
