{
  "name": "@prahalad-nagu/fast-translation-plugin",
  "version": "0.1.0",
  "description": "Production-ready translation platform core for UI microcopy using OpenAI",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "translation",
    "i18n",
    "openai",
    "typescript"
  ],
  "author": "prahalad-nagu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/prahalad-nagu/fast-translation-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/prahalad-nagu/fast-translation-plugin/issues"
  },
  "homepage": "https://github.com/prahalad-nagu/fast-translation-plugin#readme",
  "dependencies": {
    "knex": "^3.1.0",
    "openai": "^4.104.0"
  },
  "peerDependencies": {
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "react": ">=18.0.0",
    "redis": "^4.6.0",
    "sqlite3": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "redis": "^4.7.0",
    "sqlite3": "^5.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
